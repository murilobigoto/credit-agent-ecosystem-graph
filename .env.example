# Configuracao do ecossistema de credito - Banco Poneiu
# Copie para .env e preencha ANTHROPIC_API_KEY com sua chave.
# Para testes offline sem API, defina USE_FAKE_LLM=1.

# 0 = usa API real (Anthropic), 1 = FakeLLM offline (testes/CI)
USE_FAKE_LLM=0

# Chave da API Anthropic (obrigatoria quando USE_FAKE_LLM=0)
# Obtenha em: https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Modelos por etapa
# small: roteamento, fallback bancario, refinamento de saida
# large: decisao critica de credito (concessao/renegociacao)
MODEL_SMALL=claude-haiku-4-5-20251001
MODEL_LARGE=claude-sonnet-4-6

# Limiar de confianca do roteador (abaixo disso pede clarificacao)
ROUTER_CONFIDENCE_THRESHOLD=0.7

# Observabilidade - OpenTelemetry (opcional, deixe vazio para desativar)
OTEL_EXPORTER_OTLP_ENDPOINT=
